# Copy to .env and fill in real values. Never commit .env.

# Groq API key — https://console.groq.com (free tier). Leave unset or
# prefixed with "dummy" to run the LLM in offline/rule-based fallback mode
# (useful for local dev, tests, and demos without hitting a real API).
GROQ_API_KEY=dummy-local-dev-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_S=15
GROQ_MAX_RETRIES=3

# ASR
WHISPER_MODEL=base
MAX_AUDIO_MB=15

# TTS
COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC
TTS_CACHE_SIZE=64

# Conversation memory
MAX_HISTORY_TURNS=8
MAX_TEXT_CHARS=2000

# API security — leave API_KEY unset to disable auth (local dev default).
# Set it to require `Authorization: Bearer <API_KEY>` on every request.
API_KEY=
RATE_LIMIT=30/minute
CORS_ORIGINS=*

# Observability
LOG_LEVEL=INFO
ENVIRONMENT=development

# Frontend
BACKEND_URL=http://localhost:8000
