# ── Stage 1: Builder ──────────────────────────────────────────
# Install heavy dependencies in a separate stage to keep final image cleaner
FROM python:3.11-slim AS builder

WORKDIR /app

# System dependencies needed for Whisper, Coqui, and audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    espeak-ng \
    libsndfile1 \
    libgomp1 \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt


# ── Stage 2: Runtime ──────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Only copy runtime system libs (not build tools). curl is needed for the
# HEALTHCHECK below — it was missing before, which made the compose
# healthcheck fail silently (curl: command not found) rather than reflect
# real backend health.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    espeak-ng \
    libsndfile1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy backend source code (as a package, "backend/", not its contents —
# absolute imports like `from backend.config import ...` depend on this)
COPY backend/ ./backend/

# Run as a non-root user — the original image ran the service as root,
# which is an unnecessary privilege escalation surface for a network-facing
# process with no need for it.
RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /home/appuser/.cache/whisper /home/appuser/.local/share/tts \
    && chown -R appuser:appuser /home/appuser /app
USER appuser
ENV HOME=/home/appuser

EXPOSE 8000

# Absolute imports (backend.config, backend.services.*) need the repo root
# on the path, not backend/ itself — the old PYTHONPATH=/app/backend broke
# that. WORKDIR is already /app so this is just being explicit.
ENV PYTHONPATH=/app

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]